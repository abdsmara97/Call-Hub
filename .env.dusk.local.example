###############################################################################
# Dusk profile — copy to .env.dusk.local before running `php artisan dusk`.
#
# Dusk swaps this in for the duration of the run. It must point at a REAL
# database and a REAL Reverb server: the browser talks to the app over HTTP in
# a separate process, so an in-memory SQLite database and a null broadcaster
# would leave every emergency assertion waiting for an event that never fires.
###############################################################################

APP_NAME="Oak Tree Venture Hub"
APP_ENV=dusk.local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# A file-backed SQLite database, thrown away between runs. Point this at a
# scratch MySQL database instead if you want the FULLTEXT search path covered.
DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

# Fast hashing: the suite creates a dozen accounts per test.
BCRYPT_ROUNDS=4

SESSION_DRIVER=file
CACHE_STORE=file

# Synchronous, so an emergency's fan-out has already happened by the time the
# assertion runs. Horizon is not part of the browser suite.
QUEUE_CONNECTION=sync

# Reverb must actually be running: `php artisan reverb:start`.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=oaktree-dusk
REVERB_APP_KEY=oaktree-dusk-key
REVERB_APP_SECRET=oaktree-dusk-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
HUB_ATTACHMENT_DRIVER=local
HUB_AVATAR_DRIVER=local

SCOUT_DRIVER=database

MAIL_MAILER=array

# Web Push is not exercised by the browser suite — Chrome cannot be granted
# the permission headlessly — so leave the VAPID pair empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
