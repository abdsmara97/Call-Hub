###############################################################################
# Saai
#
# Two profiles are described below. The uncommented values are the LOCAL profile
# (SQLite + database queue) so a fresh clone runs with no extra servers. The
# commented "PRODUCTION" blocks are the intended self-hosted stack: MySQL 8,
# Redis + Horizon, Reverb behind nginx, S3-compatible object storage.
###############################################################################

APP_NAME="ساعي"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------- database
# LOCAL: file-backed SQLite, zero setup.
DB_CONNECTION=sqlite

# PRODUCTION: MySQL 8. Full-text message search requires MySQL — on SQLite the
# search service degrades to LIKE matching.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=oaktree_hub
# DB_USERNAME=oaktree
# DB_PASSWORD=

# --------------------------------------------------------------------- sessions
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set both to true once the app is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------ queues and cache
# LOCAL: database queue so `php artisan queue:work` needs no Redis.
QUEUE_CONNECTION=database
CACHE_STORE=database

# PRODUCTION: Redis, driven by Horizon.
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PREFIX=oaktree_horizon:

# ------------------------------------------------------------------- broadcast
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=oaktree-local
REVERB_APP_KEY=oaktree-local-key
REVERB_APP_SECRET=oaktree-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Both default to 10,000 bytes, which is sized for chat. Call signalling sends
# SDP over the same socket, and a Chrome offer that carries video can exceed
# that — Reverb closes the connection rather than truncating, so the symptom
# would be "turning the camera on kills the call". Trickle ICE keeps candidates
# tiny; this is purely headroom for the offer itself.
REVERB_MAX_REQUEST_SIZE=32000
REVERB_APP_MAX_MESSAGE_SIZE=32000

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ----------------------------------------------------------------------- files
FILESYSTEM_DISK=local
HUB_ATTACHMENT_DRIVER=local
HUB_AVATAR_DRIVER=local
# 40 MB per file, 80 MB across one message. Raising these needs matching changes
# outside the app: config/livewire.php's temporary-upload rule reads the same var,
# but nginx client_max_body_size and PHP upload_max_filesize / post_max_size are
# separate ceilings and the lowest one wins. See the README.
HUB_ATTACHMENT_MAX_KB=40960
HUB_ATTACHMENT_MAX_BATCH_KB=81920

# PRODUCTION: S3-compatible (MinIO, Wasabi, Backblaze B2, or AWS itself).
# HUB_ATTACHMENT_DRIVER=s3
# HUB_AVATAR_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------- search
# Scout's database driver uses the MySQL FULLTEXT index on `messages.body`.
# No separate search engine is warranted at this scale.
SCOUT_DRIVER=database
SCOUT_QUEUE=true

# ------------------------------------------------------------------- emergency
HUB_ESCALATION_INTERVAL=2
HUB_MAX_ESCALATIONS=5
HUB_EMERGENCY_PER_WINDOW=1
HUB_EMERGENCY_WINDOW_MINUTES=5
HUB_EMERGENCY_PER_DAY=8
HUB_MISUSE_THRESHOLD=5

# Browser push. Generate a pair with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:it@oaktreetech.com"
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# ----------------------------------------------------------------------- calls
# 1:1 audio/video in direct messages. Media is peer-to-peer and never touches
# this server; only the ring and the relay credentials do.
HUB_CALLS_ENABLED=true
HUB_CALL_RING_SECONDS=35

# Cloudflare Realtime TURN, for the calls that cannot get through corporate NAT.
#
# UNLIKE VAPID ABOVE, THERE IS NO PUBLIC HALF HERE. Neither of these ever gets a
# VITE_ twin and neither may be rendered into a meta tag — a TURN credential in
# the front-end bundle is how organisations get their relay bandwidth stolen.
# The browser receives only short-lived credentials, minted per call by
# POST /calls/{room}/ice-servers.
#
# Leave blank for local development: the app falls back to public STUN, which is
# enough for two browsers on the same machine.
#
# WHERE THESE COME FROM: the Cloudflare dashboard, Realtime -> TURN Keys ->
# Create TURN Key. The pair it shows you is the key id and that key's OWN token —
# not an account-wide token from My Profile -> API Tokens, which this endpoint
# does not accept. The token is displayed once; if it is lost, roll a new key.
#
# Nothing about this is visible on one machine: two browsers here connect over
# host candidates and never allocate a relay. To prove the credentials actually
# work, force ICE to refuse everything else by adding
# `iceTransportPolicy: 'relay'` to createPeerConnection() in
# resources/js/call-peer.js, place a call, and take it out again afterwards.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Only for pointing at a different Cloudflare region or a mock in a test rig.
# Defaults to https://rtc.live.cloudflare.com/v1/turn/keys, which is correct.
# CLOUDFLARE_TURN_ENDPOINT=

# --------------------------------------------------------------------- huddles
# Room huddles: many-to-many audio, video and screen share in ANY room, including
# the company-wide room with hundreds of members. Audio is published on joining;
# camera and screen share are opt-in from the controls.
#
# Unlike the 1:1 calls above, media does NOT go peer-to-peer — every stream
# passes through the self-hosted LiveKit SFU. That is what makes the participant
# cap a bandwidth decision rather than a preference, and it is why huddles have
# their own kill switch: during a bandwidth incident you need to stop the
# expensive thing without also taking away free peer-to-peer calling.
#
# Starting a huddle rings nobody. It puts a banner in the room, and that is all.
HUB_HUDDLES_ENABLED=true
HUB_HUDDLE_MAX_PARTICIPANTS=30

# Self-hosted LiveKit.
#
# LIVEKIT_URL is public, and still gets no VITE_ twin: POST /huddles/{room}/join
# hands it to the browser at join time. Keeping it out of the bundle means moving
# the SFU to its own box is a DNS change, not a front-end rebuild.
#
# THE KEY AND SECRET ARE SERVER-ONLY, and the warning above CLOUDFLARE_TURN_API_TOKEN
# applies here with more force. That token could cost you relay bandwidth. This
# secret signs BOTH the join tokens we hand out AND the webhooks LiveKit sends
# back — anybody holding it can join any huddle in the hub as any employee, and
# can forge a "Call in progress" banner in every room in the company. It never
# gets a VITE_ twin, never reaches a meta tag, and lives in exactly two places:
# here, and /etc/livekit/livekit.yaml.
#
# Blank by default on purpose. With no LiveKit configured RoomPolicy::huddle()
# returns false, so the huddle button is not rendered at all and a fresh clone
# still runs with no extra servers.
#
# LOCAL: run the committed throwaway config —
#   livekit-server --config deploy/livekit/livekit.local.yaml
# then uncomment the three lines below, which match the keys in that file:
#   LIVEKIT_URL=ws://127.0.0.1:7880
#   LIVEKIT_API_KEY=oaktree-local
#   LIVEKIT_API_SECRET=oaktree-local-development-only-not-a-real-secret
#
# Do NOT use `livekit-server --dev`. It signs with the hard-coded six-byte secret
# "secret", and HS256 needs 256 bits of key — firebase/php-jwt refuses to sign
# with anything shorter (this is what CVE-2025-45769 was about). The policy
# checks the length and fails closed, so the symptom is a huddle button that
# never appears. --dev also sends no webhooks, so the banner would not work
# either way.
LIVEKIT_URL=
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PRODUCTION: signalling terminates at nginx on its own hostname; the SFU itself
# binds loopback, so the API URL stays local even when the browser URL does not.
# LIVEKIT_URL=wss://rtc.oaktreetech.com
# LIVEKIT_API_URL=http://127.0.0.1:7880

# ------------------------------------------------------------------------ mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hub@oaktreetech.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Billing (Laravel Cashier / Stripe)
# --------------------------------------------------------------------------
# HUB_BILLING_ENFORCED is the master switch. Off (default): every feature,
# including the emergency system, behaves as fully paid — right for
# development, tests, and a self-hosted single-tenant install. On: seats
# bill per account and raising emergencies requires the add-on.
HUB_BILLING_ENFORCED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SEAT_PRICE_ID=
STRIPE_EMERGENCY_PRICE_ID=
