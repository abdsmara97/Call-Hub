###############################################################################
# Oak Tree Venture Hub
#
# Two profiles are described below. The uncommented values are the LOCAL profile
# (SQLite + database queue) so a fresh clone runs with no extra servers. The
# commented "PRODUCTION" blocks are the intended self-hosted stack: MySQL 8,
# Redis + Horizon, Reverb behind nginx, S3-compatible object storage.
###############################################################################

APP_NAME="Oak Tree Venture Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------- database
# LOCAL: file-backed SQLite, zero setup.
DB_CONNECTION=sqlite

# PRODUCTION: MySQL 8. Full-text message search requires MySQL — on SQLite the
# search service degrades to LIKE matching.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=oaktree_hub
# DB_USERNAME=oaktree
# DB_PASSWORD=

# --------------------------------------------------------------------- sessions
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set both to true once the app is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------ queues and cache
# LOCAL: database queue so `php artisan queue:work` needs no Redis.
QUEUE_CONNECTION=database
CACHE_STORE=database

# PRODUCTION: Redis, driven by Horizon.
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PREFIX=oaktree_horizon:

# ------------------------------------------------------------------- broadcast
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=oaktree-local
REVERB_APP_KEY=oaktree-local-key
REVERB_APP_SECRET=oaktree-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ----------------------------------------------------------------------- files
FILESYSTEM_DISK=local
HUB_ATTACHMENT_DRIVER=local
HUB_AVATAR_DRIVER=local
HUB_ATTACHMENT_MAX_KB=10240

# PRODUCTION: S3-compatible (MinIO, Wasabi, Backblaze B2, or AWS itself).
# HUB_ATTACHMENT_DRIVER=s3
# HUB_AVATAR_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------- search
# Scout's database driver uses the MySQL FULLTEXT index on `messages.body`.
# No separate search engine is warranted at this scale.
SCOUT_DRIVER=database
SCOUT_QUEUE=true

# ------------------------------------------------------------------- emergency
HUB_ESCALATION_INTERVAL=2
HUB_MAX_ESCALATIONS=5
HUB_EMERGENCY_PER_WINDOW=1
HUB_EMERGENCY_WINDOW_MINUTES=5
HUB_EMERGENCY_PER_DAY=8
HUB_MISUSE_THRESHOLD=5

# Browser push. Generate a pair with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:it@oaktreetech.com"
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# ------------------------------------------------------------------------ mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hub@oaktreetech.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
